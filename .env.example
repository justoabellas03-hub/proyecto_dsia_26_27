# Copia este fichero como ".env" y rellena los valores. El fichero .env NUNCA se sube a Git.

# Proveedor de IA para explicar la predicción: mock (sin red, por defecto) o hf (Hugging Face)
AI_PROVIDER=mock

# Token de Hugging Face (solo si AI_PROVIDER=hf): https://huggingface.co/settings/tokens
HF_TOKEN=

# Modelo del Hub para la tarea chat_completion (owner/name)
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
